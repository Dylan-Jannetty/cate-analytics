---
import Layout from "../components/Layout.astro";
import StatCard from "../components/StatCard.astro";
import ConcentrationChart from "../components/ConcentrationChart.astro";
import HolderTable from "../components/HolderTable.astro";
import SignupForm from "../components/SignupForm.astro";
import type { WeeklyReport } from "@cate/shared";

import reportJson from "../../../pipeline/out/weekly.json";
const data = reportJson as unknown as WeeklyReport;

const m = data.market;

function fmtUsd(n: number | null, decimals = 2): string {
  if (n === null) return "—";
  if (n >= 1_000_000_000) return `$${(n / 1_000_000_000).toFixed(2)}B`;
  if (n >= 1_000_000)     return `$${(n / 1_000_000).toFixed(2)}M`;
  if (n >= 1_000)         return `$${(n / 1_000).toFixed(1)}K`;
  return `$${n.toFixed(decimals)}`;
}

function fmtDate(iso: string): string {
  return new Date(iso).toLocaleDateString("en-US", {
    weekday: "short", year: "numeric", month: "short", day: "numeric",
  });
}

const priceChangeClass = m && m.priceChange24h !== null
  ? m.priceChange24h >= 0 ? "pos" : "neg"
  : "neu";
const priceChangeSub = m && m.priceChange24h !== null
  ? `${m.priceChange24h >= 0 ? "+" : ""}${m.priceChange24h.toFixed(2)}% (24h)`
  : null;

const top20 = data.holders.slice(0, 20);
const top10Accumulators = data.topAccumulators.slice(0, 10);
---

<Layout page="home">
  <section class="section">
    <div class="as-of">
      <span>As of {fmtDate(data.snapshotDate)}</span>
      <span>{data.holderCountRaw.toLocaleString()} raw holders · {data.holderCountFiltered.toLocaleString()} filtered entities</span>
    </div>

    <div class="stat-grid">
      <StatCard
        label="Price"
        value={m ? `$${m.priceUsd.toFixed(m.priceUsd < 0.01 ? 6 : 4)}` : "—"}
        sub={priceChangeSub ?? undefined}
        subClass={priceChangeClass}
      />
      <StatCard
        label="Market Cap"
        value={fmtUsd(m?.marketCapUsd ?? null)}
      />
      <StatCard
        label="Volume 24h"
        value={fmtUsd(m?.volumeUsd24h ?? null)}
      />
      <StatCard
        label="Liquidity"
        value={fmtUsd(m?.liquidityUsd ?? null)}
      />
      <StatCard
        label="Filtered Holders"
        value={data.holderCountFiltered.toLocaleString()}
        sub={`${data.holderCountRaw.toLocaleString()} raw`}
      />
    </div>
  </section>

  <section class="section">
    <h2>Holder Concentration</h2>
    <ConcentrationChart concentration={data.concentration} />
  </section>

  {top10Accumulators.length > 0 && (
    <section class="section">
      <div class="section-header">
        <h2>Top Accumulators</h2>
        <a href="/holders">See all holders →</a>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Address</th>
              <th class="td-right">Δ Balance</th>
              <th class="td-right">Balance</th>
              <th class="td-right">% Supply</th>
              <th>Label</th>
            </tr>
          </thead>
          <tbody>
            {top10Accumulators.map((h) => (
              <tr>
                <td class="td-mono text-muted">{h.rank}</td>
                <td>
                  <a href={h.solscanUrl} target="_blank" rel="noopener" class="text-mono">
                    {h.owner.slice(0, 4)}…{h.owner.slice(-4)}
                  </a>
                </td>
                <td class="td-right td-mono pos">{h.balanceDeltaFormatted}</td>
                <td class="td-right td-mono">{h.balance}</td>
                <td class="td-right td-mono">{h.pct.toFixed(2)}%</td>
                <td>
                  {h.isCluster && <span class="badge badge-cluster">cluster</span>}
                  {!h.isCluster && h.label && h.label !== "cluster" && (
                    <span class={`badge badge-${h.label}`}>{h.label}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-header">
      <h2>Top 20 Holders</h2>
      <a href="/holders">Full top-100 →</a>
    </div>
    <HolderTable holders={top20} />
  </section>

  <section class="section">
    <SignupForm />
  </section>
</Layout>
